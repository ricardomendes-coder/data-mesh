# ---- App ----
# Generate a strong value:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me
APP_TITLE=Report Hub

# Must stay different from Superset's cookie ("session") — same origin.
SESSION_COOKIE_NAME=report_hub_session
# Optional hardening behind the nginx /report/ mount: scope the cookie so it is
# never sent on Superset requests. Leave "/" for local `uvicorn app.main:app`.
SESSION_COOKIE_PATH=/

# ---- Authentication ----
# superset -> reuse the BI 360 login on the same origin (no Keycloak change)
# sso      -> talk to Keycloak directly (our redirect URI must be registered)
# password -> local username/password only
AUTH_MODE=superset

# Break-glass, works with any mode: re-exposes the bcrypt form at /login/local.
ENABLE_LOCAL_LOGIN=false
# Bounds how long a hub session can outlive the BI 360 session it came from.
SESSION_MAX_AGE=43200

# ---- Delegated auth (AUTH_MODE=superset) ----
# Defaults suit the bi.v360.io host; override only if the topology changes.
# SUPERSET_INTERNAL_URL=http://172.17.0.1
# SUPERSET_HOST_HEADER=bi.v360.io
# SUPERSET_LOGIN_URL=https://bi.v360.io/login/
# SUPERSET_NEXT_URL=https://bi.v360.io/report/
# SUPERSET_LOGOUT_URL=https://bi.v360.io/logout/

# ---- Keycloak SSO (same realm + client as Superset; see bi360/web.env) ----
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_METADATA_URL=https://sso.v360.io/realms/v360/.well-known/openid-configuration
SSO_SCOPE=openid email profile
# Must match a "Valid redirect URI" on the Keycloak client byte-for-byte.
SSO_REDIRECT_URI=https://bi.v360.io/report/auth/callback
# Leave false: the client is shared with Superset, so a true single logout would
# also sign the user out of BI 360.
SSO_SINGLE_LOGOUT=false
SSO_LOGOUT_REDIRECT_URI=

# ---- Bootstrap admin (only used when AUTH_MODE allows password login) ----
# Created ONLY on first startup, and only if no users exist yet.
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=change-me-too

# ---- Application database (all app state) ----
# The app's own transactional store: users, roles, permissions, charts,
# dashboards, reports and folders. A dedicated database with its own owner role,
# deliberately NOT inside `analytics` (the query console can write there, and the
# Datasets tab enumerates it). Host/port fall back to DB_HOST/DB_PORT when blank,
# since it's the same server. Until the password is set, the features that need
# it are disabled and permission checks fail open — see the README.
# Local dev reaches the internal instance through an SSH tunnel:
#   ssh -N -L 15432:<internal-endpoint>:5432 <bastion>
APP_DB_HOST=
APP_DB_PORT=
APP_DB_NAME=report_hub
APP_DB_USER=report_hub_user
APP_DB_PASSWORD=

# ---- Database (one server + login; the database is chosen per request) ----
# DB_HOST is the server endpoint reachable from this host — e.g. an RDS
# endpoint or private IP when running on an EC2 instance in the same VPC.
DB_HOST=your-db-endpoint
DB_PORT=5432
# DB_NAME: the database preselected in the query dropdown.
DB_NAME=analytics
# DB_CATALOG: database used only to enumerate the others for the dropdown.
DB_CATALOG=postgres
DB_USER=readonly_user
DB_PASSWORD=secret
# Postgres: postgresql+psycopg2  |  MySQL: mysql+pymysql  |  SQL Server: mssql+pyodbc
DB_DRIVER=postgresql+psycopg2

# ---- Query result limits ----
# QUERY_MAX_ROWS is the ceiling on the console's editable "rows" box. Fetching
# is done with a server-side cursor, so this bounds what leaves the database,
# not just what's shown.
QUERY_MAX_ROWS=100000
QUERY_DEFAULT_ROWS=1000
# How many rows are rendered as HTML (the export always carries all of them),
# and how many of those are shown per page.
QUERY_DISPLAY_ROWS=2000
QUERY_PAGE_SIZE=50

# ---- AI (opcional) ----
# Liga o Assistente de dados e o "Gerar com IA" na doc de datasets.
# Sem chave, esses recursos ficam desligados (nada quebra).
#
# Provedor: "anthropic" (pago) ou "openai" (qualquer API compatível — inclui os
# tiers GRÁTIS pra testar: Groq, Google Gemini, OpenRouter…).
AI_PROVIDER=openai
#
# --- Grátis pra testar (Groq: sem cartão, rápido, Llama 3.3 70B) ---
# Chave grátis em https://console.groq.com (API Keys). Depois:
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=
#
# --- Alternativa grátis: Google Gemini (AI Studio) ---
# Chave em https://aistudio.google.com/apikey, e troque:
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-2.0-flash
#
# --- V360 Assis (governado, sem billing nosso — prompt vive no Agente) ---
# Crie 2 Agentes no Assis (no-code), pegue os códigos e um token, e troque:
#   AI_PROVIDER=assis
#   ASSIS_TOKEN=...                  # Perfil do Assis → Gerar token
#   ASSIS_ASSISTANT_AGENT_KEY=...    # código do Agente do Assistente de dados
#   ASSIS_DOC_AGENT_KEY=...          # código do Agente que gera doc de dataset
#   ASSIS_CLIENT_NAME=               # opcional (tenant/ambiente)
#
# --- Anthropic nativo (pago) — se um dia quiser o Claude ---
#   AI_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#   ANTHROPIC_MODEL=claude-sonnet-5
